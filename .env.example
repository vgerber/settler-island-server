# Settler Island server configuration. The server reads the process environment; it does not load this file itself.
# Local use:  cp .env.example .env && set -a && . ./.env && set +a && cargo run -p settler_island_server
# A blank value counts as unset and keeps the default shown in brackets.

# Required. Signs guest session tokens, at least 32 bytes. Generate one with: openssl rand -base64 48
# This value is a placeholder for local development only; never reuse it anywhere else.
SETTLER_SESSION_SECRET=local-development-secret-change-me-0123456789

# Address and port to listen on. [127.0.0.1:8253]
SETTLER_BIND=127.0.0.1:8253

# Compile-time query checking uses the committed .sqlx data, so a build needs no running database. sqlx reads this from
# .env at compile time. Only `cargo sqlx prepare` ignores it, and it needs the database up. [false]
SQLX_OFFLINE=true

# Postgres connection URL (docker compose up -d db). Unset keeps games and account links in memory only.
DATABASE_URL=postgres://settler:settler@127.0.0.1:6436/settler_island
# Postgres pool size, and how many seconds a store call waits for a free connection. [8] [5]
SETTLER_DB_MAX_CONNECTIONS=8
SETTLER_DB_ACQUIRE_TIMEOUT_SECONDS=5

# Postgres-backed tests create their own databases on this server; unset skips them (docker compose up -d db).
#SETTLER_TEST_DATABASE_URL=postgres://settler:settler@127.0.0.1:6436/settler_island

# Keycloak accounts: set both or neither (guests only). The issuer must equal the tokens' iss claim.
# Local realm: docker compose --profile auth up -d keycloak
SETTLER_KEYCLOAK_ISSUER=
SETTLER_KEYCLOAK_AUDIENCE=
#SETTLER_KEYCLOAK_ISSUER=http://127.0.0.1:8086/realms/settler-island
#SETTLER_KEYCLOAK_AUDIENCE=settler-island-server

# Pause before each bot move, in milliseconds. [600]
SETTLER_BOT_DELAY_MILLISECONDS=600

# A running game whose lobby had no connected human for this many hours is closed for good; at most 8760. [168]
SETTLER_ABANDON_AFTER_HOURS=168
# The same, in minutes, for a game whose humans all left it to the bots; at most 525600. [30]
SETTLER_UNATTENDED_ABANDON_MINUTES=30

# Caps: open WebSocket connections in total and per client address, games running at once, and lobbies or games one
# user may take part in at once. [1000] [20] [500] [3]
SETTLER_MAX_CONNECTIONS=1000
SETTLER_MAX_CONNECTIONS_PER_IP=20
SETTLER_MAX_RUNNING_GAMES=500
SETTLER_MAX_GAMES_PER_USER=3
# A connection that has not sent Authenticate within this many seconds is closed. [10]
SETTLER_AUTH_TIMEOUT_SECONDS=10

# Rate limit of POST /api/v1/sessions/* per client address: sustained requests per minute and burst. [10] [5]
SETTLER_SESSION_REQUESTS_PER_MINUTE=10
SETTLER_SESSION_BURST=5
# Take the client address from X-Forwarded-For; true only behind a reverse proxy that sets it and only when the game
# port is reachable from that proxy alone. [false]
SETTLER_TRUST_FORWARDED_FOR=false
# Comma-separated IP addresses of the proxies whose X-Forwarded-For is honoured; required when the line above is true.
SETTLER_TRUSTED_PROXIES=
#SETTLER_TRUSTED_PROXIES=192.168.178.20

# Serve /metrics on this separate address (an internal network) instead of SETTLER_BIND. Unset keeps it on SETTLER_BIND.
SETTLER_METRICS_BIND=
#SETTLER_METRICS_BIND=127.0.0.1:9253

# Log filter in tracing syntax, e.g. info or settler_island_server=debug,warn. [info]
RUST_LOG=info
# text or json (one JSON object per line). [text]
SETTLER_LOG_FORMAT=text

# How long a bot that offered a trade waits for the humans it asked, in seconds. [20]
SETTLER_TRADE_ANSWER_SECONDS=20
